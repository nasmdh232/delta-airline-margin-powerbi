    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What it means",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "20pt",
                      "color": "#F0455A"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Most of the profit improvement came from a cost Delta does not control. When fuel was cheap, margin rose; the underlying cost and unit-revenue position did not improve.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "18pt",
                      "color": "#E8EDF5"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#E8EDF5"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Fuel is already reversing. It reached 20.8% and 21.6% of revenue in Q2 and Q3 2026, against 15.5% in FY2025.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "18pt",
                      "color": "#E8EDF5"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#E8EDF5"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Stress test: at the FY2025 mix, every +10% in fuel price costs about 1.5 pts of operating margin if fares and capacity do not respond. That is an upper bound, not a forecast.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "18pt",
                      "color": "#E8EDF5"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#E8EDF5"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]

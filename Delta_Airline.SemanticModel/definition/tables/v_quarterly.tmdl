	partition v_quarterly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "v_quarterly.csv"), [Delimiter = ",", Columns = 28, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"airline_id", type text}, {"fiscal_year", Int64.Type}, {"fiscal_quarter", Int64.Type}, {"label", type text}, {"period_end", type date}, {"revenue", type number}, {"fuel_expense", type number}, {"labor_expense", type number}, {"d_and_a", type number}, {"operating_income", type number}, {"net_income", type number}, {"interest_expense", type number}, {"ebitda", type number}, {"operating_margin", type number}, {"net_margin", type number}, {"fuel_pct_rev", type number}, {"labor_pct_rev", type number}, {"cfo", type number}, {"capex", type number}, {"free_cash_flow", type number}, {"cash", type number}, {"st_investments", type number}, {"liquidity", type number}, {"current_assets", type number}, {"current_liabilities", type number}, {"equity", type number}, {"total_assets", type number}, {"total_debt", type number}}, "en-US")
				in
				    Typed

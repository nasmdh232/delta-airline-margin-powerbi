	partition v_annual = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "v_annual.csv"), [Delimiter = ",", Columns = 25, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"airline_id", type text}, {"fiscal_year", Int64.Type}, {"revenue", type number}, {"fuel_expense", type number}, {"labor_expense", type number}, {"d_and_a", type number}, {"operating_income", type number}, {"net_income", type number}, {"interest_expense", type number}, {"interest_basis", type text}, {"cfo", type number}, {"capex", type number}, {"free_cash_flow", type number}, {"ebitda", type number}, {"operating_margin", type number}, {"net_margin", type number}, {"fuel_pct_rev", type number}, {"labor_pct_rev", type number}, {"liquidity", type number}, {"total_debt", type number}, {"debt_to_ebitda", type number}, {"net_debt_to_ebitda", type number}, {"interest_coverage", type number}, {"equity", type number}, {"total_assets", type number}}, "en-US")
				in
				    Typed
